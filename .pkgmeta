# https://github.com/BigWigsMods/packager
package-as: DefaultQuestTrackerClassic

ignore:
  - .git
  - .github
  - .cursor
  - .gitignore
  - .pkgmeta
  - .compiled
  - .release
  - CURSEFORGE_DESCRIPTION.md
  - VERSION
  - docs
  - tests
  - tools
  - "**/.DS_Store"
  - "**/Thumbs.db"
  - "**/__pycache__"

manual-changelog: RELEASE_NOTES.md
